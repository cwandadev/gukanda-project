# Copy to .env.local and fill in (Supabase Dashboard > Project Settings > API / Connect).
# These two are PUBLIC: anything starting with EXPO_PUBLIC_ is shipped inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NEVER put the secret key / service_role key in this file or in any EXPO_PUBLIC_ variable.
